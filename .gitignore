# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# Environment
# Keep real secret files out of Git, but allow example templates to be committed.
.env
.env.local
.env.*.local
!.env.example

# Local runtime/cache data
.pnpm-store/
artifacts/api-server/.sessions/
artifacts/api-server/.wwebjs_cache/
# WhatsApp (whatsapp-web.js) browser sessions — live auth data, never commit
.sessions/
**/.sessions/
**/.wwebjs_cache/

# Supabase CLI local state (created by `supabase link`)
supabase/.temp/
supabase/.branches/

# Local-only, not shared with the team
artifacts/bookza/tableguard/

# Local Claude notes (not shared with the team)
CLAUDE.md
