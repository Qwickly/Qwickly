# Meta WhatsApp Cloud API template settings for outbound campaign sends
# Set this to an approved message template name in your WhatsApp Business account.
META_WHATSAPP_TEMPLATE_NAME=your_template_name
META_WHATSAPP_TEMPLATE_LANG=en_US
# Optional override for the WhatsApp Cloud API version used by send-meta.
WHATSAPP_CLOUD_API_VERSION=v17.0

# Transactional email (SendGrid) for client email notifications — booking
# confirmations and 24h/2h reminders. SENDGRID_API_KEY + EMAIL_FROM_ADDRESS are
# both required to enable email sending; if unset, email notification rows simply
# wait in the queue.
# Stage 1: send from the verified Qwickly domain only. From display is
# "<business> via Qwickly"; Reply-To is the business's own email.
# SENDGRID_API_KEY:   from https://sendgrid.com (Settings → API Keys, "Mail Send")
# EMAIL_FROM_ADDRESS: a sender on the DNS-authenticated Qwickly domain (SPF/DKIM)
# EMAIL_FROM_NAME:    base brand name for the From display (default "Qwickly")
SENDGRID_API_KEY=
EMAIL_FROM_ADDRESS=bookings@qwickly.co.za
EMAIL_FROM_NAME=Qwickly

# Public base URL of the frontend app — used to build the "Manage booking" magic
# link in confirmation/reminder emails (…/booking/manage/<token>). No trailing slash.
# Dev: http://localhost:23168   Prod: your deployed frontend origin.
APP_BASE_URL=http://localhost:23168

# Facebook/Meta OAuth for the popup connection flow
FACEBOOK_OAUTH_APP_ID=your_facebook_app_id
FACEBOOK_OAUTH_APP_SECRET=your_facebook_app_secret
FACEBOOK_OAUTH_API_VERSION=v16.0
FACEBOOK_OAUTH_REDIRECT_URI=http://localhost:3000/api/facebook/callback
FACEBOOK_OAUTH_STATE_SECRET=change-me